{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero7even.net/schemas/launcher-update-manifest.schema.json",
  "title": "Zero7even Launcher Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "channel", "publishedAt", "artifacts"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "dev"]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseNotes": {
      "type": ["string", "null"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url", "sha256", "size"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["windows-x64", "linux-x64", "macos-x64", "macos-arm64", "android"]
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
